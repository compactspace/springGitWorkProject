<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="FakeArtworkMapper">

<!-- SELECT FOR UPDATE -->
    <select id="selectFakeArtworksForUpdate" resultType="map">
        SELECT *
        FROM fakeartworks
        WHERE id > 0
        FOR UPDATE
    </select>

    <!-- UPDATE -->
    <update id="updateCheckedFakeArtworks">
        UPDATE fakeartworks
        SET view = view + 1
        WHERE id > 0
    </update>

</mapper>