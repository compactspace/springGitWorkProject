<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="productRefundMapper">




<select id="existsByPaymentId" parameterType="ProductRefundDTO" resultType="ProductRefundDTO">
    SELECT * FROM product_refund WHERE payment_id=#{paymentId}
</select>


<insert id="productReqeustRefund" parameterType="ProductRefundDTO">
    INSERT INTO product_refund (payment_id, refunded_amount, reason)
    VALUES (#{paymentId}, #{refundedAmount}, #{reason})
</insert>


</mapper>
