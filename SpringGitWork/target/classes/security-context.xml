<?xml version="1.0" encoding="UTF-8"?>
<beans:beans
	xmlns="http://www.springframework.org/schema/security"
	xmlns:beans="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:util="http://www.springframework.org/schema/util"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation="http://www.springframework.org/schema/security http://www.springframework.org/schema/security/spring-security.xsd
			http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc-4.3.xsd
			http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd
			http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd
			http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-4.3.xsd">

	<!-- 폼기반이다. -->
	
		<http pattern="/err**" security="none" />
	<http pattern="/resources/img_mainhome/**" security="none" />
	<http pattern="/resources/img_onedayclass/**" security="none" />
	<http pattern="/resources/img/**" security="none" />
	<http pattern="/resources/img_board/**" security="none" />
	<http pattern="/resources/img_cart/**" security="none" />
	<http pattern="/resources/img_icon/**" security="none" />
	<http pattern="/resources/img_infoicon/**" security="none" />
	<http pattern="/resources/img_login/**" security="none" />
	<http pattern="/resources/img_main/**" security="none" />
	<http pattern="/resources/img_membership/**" security="none" />
	<http pattern="/resources/img_product/**" security="none" />
	<http pattern="/resources/img_review/**" security="none" />
	<http pattern="/resources/js/**" security="none" />
<http pattern="/api/guest/**" security="none" />

	<!-- 1. 사용자 뷰 (JSP 페이지) -->
<!-- 1. 사용자 뷰 (JSP 페이지) 관련 보안 설정 -->
<http pattern="/users/**" auto-config="true" use-expressions="true"  entry-point-ref="myAuthenticationEntryPoint">

    <!-- 권한이 없을 때(403 Forbidden) 처리하는 커스텀 핸들러 지정 -->
    <!--
        - 이미 인증된 사용자가 권한 부족 시 호출됨
        - 예: 로그인은 했지만 ROLE_USER 권한이 없을 때
        - 비로그인 상태에서는 호출되지 않음(로그인 페이지 리다이렉트 됨)
    -->
    <access-denied-handler ref="my403" />

    <!-- /users/board/** 경로는 ROLE_USER 권한이 있어야 접근 허용 -->
    <intercept-url pattern="/users/board/**" access="hasRole('ROLE_USER')" />

    <!-- /users/** 경로는 로그인(인증)된 사용자만 접근 가능 -->
    <intercept-url pattern="/users/**" access="isAuthenticated()" />
    
    <!-- 로그인 관련 설정 명시적으로 추가 -->
    <!--
        - 로그인 페이지 URL 지정 (/guest/login)
        - 로그인 처리 URL (/guest/api/logingo.do)
        - 로그인 시 사용할 파라미터 이름 지정 (loginId, loginPwd)
        - 로그인 성공 시 이동할 기본 페이지 (/users/dashboard)
        - 로그인 실패 시 이동할 페이지 (/guest/login?error=true)
        - 없으면 Spring Security 기본 동작 적용, 명시하는 것이 명확함
    -->
	<!-- 로그아웃 -->
		<logout logout-url="/users/logout"
			logout-success-url="/guest/" />
    
</http>


	<!-- 2. 사용자 API -->
	<http pattern="/api/user/**" auto-config="true"
		use-expressions="true">
		<intercept-url pattern="/api/user/**"
			access="isAuthenticated()" />
	</http>

	<!-- 3. 관리자 API -->
	<http pattern="/api/admin/**" auto-config="true"
		use-expressions="true">
		<intercept-url pattern="/api/admin/**"
			access="hasRole('ROLE_ADMIN')" />
	</http>

	<!-- ✅ 4. 기본 영역: 로그인, 공용 API 등 (항상 마지막!!) -->
	<http auto-config="true" use-expressions="true">
		<!-- 로그인, 로그인 처리 -->
		<intercept-url pattern="/guest/login" access="permitAll" />
		<intercept-url pattern="/guest/api/logingo.do"
			access="permitAll" />

		<!-- 공용 API -->
		<intercept-url pattern="/api/product/**"
			access="permitAll" />
		<custom-filter before="FORM_LOGIN_FILTER"
			ref="loginFormUserFilter" />
		<!-- 로그인 설정 -->
		<form-login login-page="/guest/login"
			login-processing-url="/guest/api/logingo.do"
			username-parameter="loginId" password-parameter="loginPwd"
			default-target-url="/users/dashboard"
			authentication-failure-url="/guest/login?error=true" />

	
	</http>



	<!-- 관리자 영역 -->
	<!-- <http auto-config="true" use-expressions="true"> <access-denied-handler 
		ref="my403" /> <intercept-url pattern="/board/**" access="ROLE_USER" /> <intercept-url 
		pattern="/hell/**" access="ROLE_ADMIN" /> <custom-filter before="LOGOUT_FILTER" 
		ref="formLogOutFilter" /> <custom-filter before="FORM_LOGIN_FILTER" ref="loginFormFilter" 
		/> <csrf disabled="true" /> <form-login username-parameter="loginId" password-parameter="loginPwd" 
		login-processing-url="/logingo.do" login-page="/loginfom.do" default-target-url="/loginfom.do" 
		/> <logout logout-url="/securitylogout.do" success-handler-ref="fomLogOutSuccessHandler" 
		/> </http> -->

	<!-- 폼기간 일반유저 로그인 검증할 매니져를 만든다. -->
	<authentication-manager
		alias="userAuthenticationManager">
		<authentication-provider
			ref="userAuthenticationProvider" />
	</authentication-manager>



	<beans:bean id="userAuthenticationProvider"
		class="com.spring.FormSecurity.UserFormAuthenticationProvider" />


	<!-- 유저 검증 성공후 처리할 핸들러 -->
	<beans:bean id="userSuccessHandler"
		class="com.spring.FormSecurity.UserFormSecuritySuccessHandler" />




	<!-- 폼 기반 유저 로그인 필터를 등록해서 로그인 -->
	<beans:bean id="loginFormUserFilter"
		class="com.spring.FormSecurity.AuthenticationUserFilter"
		p:authenticationManager-ref="userAuthenticationManager"
		p:authenticationSuccessHandler-ref="userSuccessHandler" />


	<beans:bean id="userLogoutSuccessHandler"
		class="com.spring.FormSecurity.UserFomLogOutSuccessHandler">
	</beans:bean>




<beans:bean id="myAuthenticationEntryPoint"
    class="com.spring.FormSecurity.MyAuthenticationEntryPoint" />






	<!-- 여기서부터는 관리자시작 -->




	<authentication-manager
		alias="authenticationManager">
		<authentication-provider
			ref="adminAuthenticationProvider" />
	</authentication-manager>




	<beans:bean id="adminAuthenticationProvider"
		class="com.spring.FormSecurity.FormAuthenticationProvider" />




	<!-- 관리자 검증 성공후 처리할 핸들러 -->
	<beans:bean id="successHandler"
		class="com.spring.FormSecurity.FormSecuritySuccessHandler" />





	<!-- 폼 기반 관리자 로그인 필터를 등록해서 로그인 -->
	<beans:bean id="loginFormFilter"
		class="com.spring.FormSecurity.AuthenticationFilter"
		p:authenticationManager-ref="authenticationManager"
		p:authenticationSuccessHandler-ref="successHandler" />





	<!-- 권한 없는 페이지 접근시 핸들러임... -->
	<beans:bean id="fomLogOutSuccessHandler"
		class="com.spring.FormSecurity.FomLogOutSuccessHandler">


	</beans:bean>


	<beans:bean id="formLogOutHandler"
		class="com.spring.FormSecurity.FormLogOutHandler">
	</beans:bean>

	<!-- <beans:bean id="formLogOutFilter" class="com.spring.FormSecurity.FormLogOutFilter"> 
		</beans:bean> -->


	<!-- 권한 없는 페이지 접근시 핸들러임... -->
	<beans:bean id="my403"
		class="com.spring.finall.security.MyAccessDeniedHandler">
		<beans:property name="errorPage" value="403" />
	</beans:bean>




</beans:beans>
